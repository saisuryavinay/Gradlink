PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=

# ─── Email (Resend — recommended for production on Render) ─────────────────────
# Sign up free at https://resend.com → API Keys → Create API Key
# Without a verified custom domain, Resend sends from onboarding@resend.dev
# which works fine for delivering OTPs to any recipient.
RESEND_API_KEY=
# Optional: override sender once you verify a custom domain in Resend
# EMAIL_FROM=GradLink <noreply@yourdomain.com>

# ─── Email (Gmail SMTP — fallback / local dev only) ───────────────────────────
# Gmail SMTP is often blocked on Render (AWS IPs). Use Resend for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GradLink <noreply@gradlink.app>

ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development